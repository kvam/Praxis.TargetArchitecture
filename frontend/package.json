{
    "name": "praxis-target-architecture-frontend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "autogenerate-models": "openapi-ts && prettier --write src/models/generated --log-level warn",
        "build": "tsc --noEmit",
        "lint": "eslint \"src/**/*.{ts,tsx}\"",
        "start": "vite",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\""
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^9.4.0",
        "@tanstack/react-query": "^5.102.8",
        "highlight.js": "^11.12.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "styled-components": "^6.5.3"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "^0.99.0",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vite-plugin-checker": "^0.14.5"
    }
}
